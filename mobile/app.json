{
  "expo": {
    "name": "Our Village (நமது கிராமம்)",
    "slug": "our-village-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#065f46"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ourvillage.connect",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Our Village needs your location to provide regional recruitment notifications and local district news."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#065f46"
      },
      "package": "org.ourvillage.connect",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "VIBRATE"
      ]
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:5000/api"
    }
  }
}
